<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnMaker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="制作" />
                <Button android:id="@+id/btnTemplates" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模板" />
                <Button android:id="@+id/btnMusic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="音乐" />
                <Button android:id="@+id/btnHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="历史" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. 选择截图 → 裁剪"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:paddingBottom="8dp"
            android:text="先在抖音里截好包含商品、券后价、规格等内容的截图，再从相册导入。" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnPickImage"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:text="选择截图"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnRecrop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="重新裁剪" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. 双贴纸标题（拖动两个红块）"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.local.douyinmaker.ui.OverlayPreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="520dp"
            android:layout_marginTop="6dp"
            android:background="#111111" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnPresetRef"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="套用参考图1" />
            <Button
                android:id="@+id/btnPresetAlt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="套用垃圾袋版" />
        </LinearLayout>

        <EditText
            android:id="@+id/etMainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="主标题，例如：白拿一个手机支架" />

        <EditText
            android:id="@+id/etSubText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="副标题，例如：hhh" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnChooseTemplate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择模板" />
            <Button
                android:id="@+id/btnSaveTemplate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存当前模板" />
        </LinearLayout>

        <TextView android:id="@+id/tvMainSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="主标题字号：104" />
        <SeekBar android:id="@+id/seekMainSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="54" />

        <TextView android:id="@+id/tvSubSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="副标题字号：84" />
        <SeekBar android:id="@+id/seekSubSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="44" />

        <TextView android:id="@+id/tvMainRotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="主标题旋转：-7°" />
        <SeekBar android:id="@+id/seekMainRotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="40" android:progress="13" />

        <TextView android:id="@+id/tvSubRotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="副标题旋转：-7°" />
        <SeekBar android:id="@+id/seekSubRotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="40" android:progress="13" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="默认样式：红底白字，位置和大小按你给的达人图做了预设。" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3. 选音乐"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnChooseMusic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择音乐" />
            <TextView
                android:id="@+id/tvMusic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:padding="10dp"
                android:text="不加音乐（可直接生成）" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="4. 设置时长和清晰度"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="时长(秒)：" />
            <EditText
                android:id="@+id/etDuration"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="0.7" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  0.7～15 秒" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="输出：" />
            <Spinner
                android:id="@+id/spResolution"
                android:layout_width="230dp"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResolutionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="1080全屏：1080×2400（9:20，推荐）" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:text="5. 生成视频并保存到相册"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="请选择一张商品截图开始制作" />

    </LinearLayout>
</ScrollView>
